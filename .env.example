# ─────────────────────────────────────────────────────────────────────────────
# ChronoBlink Arcade — environment template. Copy to .env and fill in.
# Never commit .env. Values marked [prod] are required in production.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the arcade (no trailing slash). [prod] https://www.chronoblink.xyz
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Origin that serves untrusted game code. MUST NOT share cookies with APP_URL.
# Locally we use 127.0.0.1 (a different host than localhost, so no cookie
# sharing). [prod] use a separate registrable domain, e.g. https://play.chronoblink-games.net
GAME_ORIGIN=http://127.0.0.1:3001
NEXT_PUBLIC_GAME_ORIGIN=http://127.0.0.1:3001
GAME_HOST_PORT=3001

# PostgreSQL. `pnpm db:start` runs a local server matching this URL. [prod]
DATABASE_URL=postgres://chronoblink:chronoblink@127.0.0.1:54329/chronoblink
TEST_DATABASE_NAME=chronoblink_test

# Better Auth. Generate with: openssl rand -base64 32  [prod]
BETTER_AUTH_SECRET=dev-only-secret-change-me-dev-only-secret
# HMAC key for game preview links and local signed upload URLs. [prod]
PLATFORM_SIGNING_SECRET=dev-only-signing-secret-change-me

# Email delivery. "console" logs emails and stores them in the dev mailbox
# (/dev/mailbox, development only). "resend" sends real mail. [prod] resend
EMAIL_PROVIDER=console
EMAIL_FROM="ChronoBlink Arcade <no-reply@chronoblink.xyz>"
RESEND_API_KEY=

# Optional Google sign-in. Leave blank to hide the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Storage for game builds and media. "local" writes to .data/storage.
# "r2" uses Cloudflare R2 through its S3 API. [prod] r2
STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=chronoblink-games
# Public base URL for published media (cover art). Leave blank to proxy through the app.
MEDIA_PUBLIC_BASE_URL=

# Cloudflare Turnstile. When blank, the check is skipped (dev only — the
# app refuses to start in production without it).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Malware scanning for uploaded game builds. "none" = no scanner, which keeps
# uploads restricted to trusted developers. "clamav" uses a clamd TCP socket.
MALWARE_SCANNER=none
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# Shared secret for scheduled jobs (POST /api/cron/*). [prod]
CRON_SECRET=dev-cron-secret

# Emails that become administrators when they register (comma separated).
ADMIN_EMAILS=

# Analytics retention in days for raw gameplay events.
ANALYTICS_RETENTION_DAYS=180
